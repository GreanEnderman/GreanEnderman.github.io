---
import BaseLayout from '@layouts/BaseLayout.astro';
import FeaturedCarousel from '@components/site/FeaturedCarousel.astro';
import { getFeaturedPosts, getRecentPosts, getPostsByCategory, formatDate } from '@lib/posts';
import { getFeaturedProjects } from '@lib/projects';

// 获取数据
const selectedFeaturedPosts = await getFeaturedPosts(5);
const featuredPosts = selectedFeaturedPosts.length > 0
  ? selectedFeaturedPosts
  : await getRecentPosts(1);
const featuredProjects = await getFeaturedProjects(5);

const techPosts = (await getPostsByCategory('tech')).slice(0, 3);
const essayPosts = (await getPostsByCategory('essay')).slice(0, 3);
const recentUpdates = await getRecentPosts(3);
---

<BaseLayout>
  <main class="pt-32 pb-24">
    <!-- Hero Section: Site Manifesto -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <span class="mono-label text-xs uppercase tracking-widest text-on-surface-variant mb-6 block">霜筠小记</span>
          <h1 class="font-headline text-5xl md:text-7xl leading-tight tracking-tight">
            <span class="block">于 <span class="text-primary">代码</span> 与 文字 之间，</span>
            <span class="block">留一隅 <span class="clean-bamboo">清筠</span></span>
          </h1>
        </div>
        <div class="lg:col-span-4 pb-2">
          <p class="text-lg text-on-surface-variant font-body leading-relaxed max-w-sm">
            记录技术、项目与偶有所思。<br />
            于方寸之间求知，也在文字之中自得。
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Section (Asymmetric Bento) -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class:list={['featured-grid', { 'featured-grid--article-only': featuredProjects.length === 0 }]}>
        <div class="featured-grid__posts">
          <FeaturedCarousel kind="post" items={featuredPosts} interval={7000} />
        </div>
        {featuredProjects.length > 0 && (
          <div class="featured-grid__projects">
            <FeaturedCarousel kind="project" items={featuredProjects} interval={9000} />
          </div>
        )}
      </div>
    </section>

    <!-- Split Sections: Tech vs Essays -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
        <!-- Recent Tech -->
        <div>
          <h3 class="font-label text-xs uppercase tracking-[0.2em] text-on-surface-variant mb-12 flex items-center gap-4">
            <span class="w-8 h-[1px] bg-outline-variant"></span> 最新技术
          </h3>
          <div class="space-y-12">
            {techPosts.map((post) => (
              <article class="group cursor-pointer">
                <a href={`/posts/${post.slug}/`}>
                  <span class="mono-label text-xs text-primary mb-2 block">
                    {post.data.category === 'tech' ? '技术笔记' : '指南'}
                  </span>
                  <h4 class="font-headline text-2xl group-hover:text-primary transition-colors">{post.data.title}</h4>
                  <p class="font-body text-on-surface-variant text-sm mt-3">{post.data.description}</p>
                </a>
              </article>
            ))}
          </div>
        </div>

        <!-- Recent Essays -->
        <div>
          <h3 class="font-label text-xs uppercase tracking-[0.2em] text-on-surface-variant mb-12 flex items-center gap-4">
            <span class="w-8 h-[1px] bg-outline-variant"></span> 最新随笔
          </h3>
          <div class="space-y-12">
            {essayPosts.map((post) => (
              <article class="group cursor-pointer">
                <a href={`/posts/${post.slug}/`}>
                  <span class="mono-label text-xs text-secondary mb-2 block">观察</span>
                  <h4 class="font-headline text-2xl group-hover:text-secondary transition-colors">{post.data.title}</h4>
                  <p class="font-body text-on-surface-variant text-sm mt-3">{post.data.description}</p>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Updates Timeline -->
    <section class="max-w-3xl mx-auto px-6 mb-32 bg-[var(--surface-container-low)] p-12 lg:p-20">
      <h3 class="font-headline text-3xl mb-12">动态更新</h3>
      <div class="space-y-16 relative">
        <!-- Timeline Line -->
        <div class="absolute left-0 top-0 bottom-0 w-[1px] bg-outline-variant opacity-30 ml-4 lg:ml-0"></div>

        {recentUpdates.map((post, index) => {
          const colors = ['primary', 'secondary', 'tertiary'];
          const color = colors[index % colors.length];
          return (
            <div class="relative pl-12 lg:pl-16">
              <div class={`absolute left-[-4px] top-2 w-2 h-2 rounded-full ring-4 ring-background bg-${color}`}></div>
              <span class="mono-label text-[10px] uppercase text-on-surface-variant block mb-2">
                {formatDate(post.data.date)}
              </span>
              <p class="font-body text-sm leading-relaxed">
                发布了 <a href={`/posts/${post.slug}/`} class="font-bold hover:text-primary transition-colors">{post.data.title}</a>
              </p>
            </div>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(15rem, 1fr);
    align-items: stretch;
    gap: 2rem;
  }

  .featured-grid--article-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .featured-grid__posts,
  .featured-grid__projects {
    min-width: 0;
  }

  .clean-bamboo {
    color: var(--secondary);
    background: linear-gradient(135deg, var(--secondary), var(--tertiary));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (max-width: 720px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
