---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getFeaturedPosts, getRecentPosts, getPostsByCategory, formatDate } from '@lib/posts';
import { getFeaturedProjects } from '@lib/projects';

// 获取数据
const featuredPosts = await getFeaturedPosts(1);
const featuredPost = featuredPosts.length > 0 ? featuredPosts[0] : (await getRecentPosts(1))[0];

const featuredProjects = await getFeaturedProjects(1);
const featuredProject = featuredProjects.length > 0 ? featuredProjects[0] : null;

const techPosts = (await getPostsByCategory('tech')).slice(0, 3);
const essayPosts = (await getPostsByCategory('essay')).slice(0, 3);
const recentUpdates = await getRecentPosts(3);
---

<BaseLayout title="数字馆长 | 代码与匠心">
  <main class="pt-32 pb-24">
    <!-- Hero Section: Site Manifesto -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8">
          <span class="mono-label text-xs uppercase tracking-widest text-on-surface-variant mb-6 block">站点宣言</span>
          <h1 class="font-headline text-5xl md:text-7xl leading-tight tracking-tight">
            在 <span class="text-primary">代码</span> 与 <span class="text-secondary">匠心</span> 的交汇处探索。
          </h1>
        </div>
        <div class="lg:col-span-4 pb-2">
          <p class="text-lg text-on-surface-variant font-body leading-relaxed max-w-sm">
            一份关于技术思考与文学感悟的策展。以装帧师的灵魂，打造数字时代的器物。
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Section (Asymmetric Bento) -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Featured Essay -->
        {featuredPost && (
          <div class="lg:col-span-2 group">
            <a href={`/posts/${featuredPost.slug}/`} class="block bg-[var(--surface-container-low)] overflow-hidden transition-colors duration-500 hover:bg-[var(--surface-container-high)] h-full flex flex-col">
              {featuredPost.data.cover && (
                <div class="aspect-video overflow-hidden">
                  <img alt={featuredPost.data.title} class="w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-105" src={featuredPost.data.cover}/>
                </div>
              )}
              <div class="p-10 flex flex-col flex-grow">
                <div class="flex justify-between items-start mb-6">
                  <span class="mono-label text-xs tracking-widest text-primary font-bold">精选文章</span>
                  <span class="mono-label text-xs text-on-surface-variant">{formatDate(featuredPost.data.date)}</span>
                </div>
                <h2 class="font-headline text-3xl mb-6 leading-snug">{featuredPost.data.title}</h2>
                <p class="font-body text-on-surface-variant mb-8 line-clamp-3">{featuredPost.data.description}</p>
                <div class="mt-auto">
                  <span class="inline-flex items-center gap-2 font-label text-xs uppercase tracking-widest border-b border-primary pb-1">阅读全文</span>
                </div>
              </div>
            </a>
          </div>
        )}

        <!-- Featured Project -->
        {featuredProject && (
          <div class="group">
            <a href={`/projects/${featuredProject.slug}/`} class="block bg-[var(--surface-container-highest)] h-full p-10 flex flex-col">
              <span class="mono-label text-xs tracking-widest text-secondary font-bold mb-8">最新项目</span>
              {featuredProject.data.cover && (
                <div class="mb-10 aspect-square bg-white shadow-sm flex items-center justify-center p-8 overflow-hidden">
                  <img alt={featuredProject.data.title} class="w-full h-full object-contain mix-blend-multiply opacity-80" src={featuredProject.data.cover}/>
                </div>
              )}
              <h3 class="font-headline text-2xl mb-4">{featuredProject.data.title}</h3>
              <p class="font-body text-sm text-on-surface-variant mb-8">{featuredProject.data.description}</p>
              <div class="mt-auto flex flex-wrap gap-2 mb-8">
                {featuredProject.data.stack.slice(0, 2).map((tech) => (
                  <span class="bg-secondary-container text-on-secondary-container px-3 py-1 text-[10px] mono-label rounded-full uppercase">{tech}</span>
                ))}
              </div>
              <span class="material-symbols-outlined text-4xl text-primary" data-icon="arrow_outward">arrow_outward</span>
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Split Sections: Tech vs Essays -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
        <!-- Recent Tech -->
        <div>
          <h3 class="font-label text-xs uppercase tracking-[0.2em] text-on-surface-variant mb-12 flex items-center gap-4">
            <span class="w-8 h-[1px] bg-outline-variant"></span> 最新技术
          </h3>
          <div class="space-y-12">
            {techPosts.map((post) => (
              <article class="group cursor-pointer">
                <a href={`/posts/${post.slug}/`}>
                  <span class="mono-label text-xs text-primary mb-2 block">
                    {post.data.category === 'tech' ? '技术笔记' : '指南'}
                  </span>
                  <h4 class="font-headline text-2xl group-hover:text-primary transition-colors">{post.data.title}</h4>
                  <p class="font-body text-on-surface-variant text-sm mt-3">{post.data.description}</p>
                </a>
              </article>
            ))}
          </div>
        </div>

        <!-- Recent Essays -->
        <div>
          <h3 class="font-label text-xs uppercase tracking-[0.2em] text-on-surface-variant mb-12 flex items-center gap-4">
            <span class="w-8 h-[1px] bg-outline-variant"></span> 最新随笔
          </h3>
          <div class="space-y-12">
            {essayPosts.map((post) => (
              <article class="group cursor-pointer">
                <a href={`/posts/${post.slug}/`}>
                  <span class="mono-label text-xs text-secondary mb-2 block">观察</span>
                  <h4 class="font-headline text-2xl group-hover:text-secondary transition-colors">{post.data.title}</h4>
                  <p class="font-body text-on-surface-variant text-sm mt-3">{post.data.description}</p>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Updates Timeline -->
    <section class="max-w-3xl mx-auto px-6 mb-32 bg-[var(--surface-container-low)] p-12 lg:p-20">
      <h3 class="font-headline text-3xl mb-12">动态更新</h3>
      <div class="space-y-16 relative">
        <!-- Timeline Line -->
        <div class="absolute left-0 top-0 bottom-0 w-[1px] bg-outline-variant opacity-30 ml-4 lg:ml-0"></div>

        {recentUpdates.map((post, index) => {
          const colors = ['primary', 'secondary', 'tertiary'];
          const color = colors[index % colors.length];
          return (
            <div class="relative pl-12 lg:pl-16">
              <div class={`absolute left-[-4px] top-2 w-2 h-2 rounded-full ring-4 ring-background bg-${color}`}></div>
              <span class="mono-label text-[10px] uppercase text-on-surface-variant block mb-2">
                {formatDate(post.data.date)}
              </span>
              <p class="font-body text-sm leading-relaxed">
                发布了 <a href={`/posts/${post.slug}/`} class="font-bold hover:text-primary transition-colors">{post.data.title}</a>
              </p>
            </div>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
