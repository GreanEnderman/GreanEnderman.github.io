---
import type { Post } from '@lib/posts';
import type { Project } from '@lib/projects';
import { formatDate } from '@lib/posts';

type Props =
  | {
      kind: 'post';
      items: Post[];
      interval: number;
    }
  | {
      kind: 'project';
      items: Project[];
      interval: number;
    };

const { kind, items, interval } = Astro.props;
const isPost = kind === 'post';
const carouselLabel = isPost ? '精选文章' : '精选项目';
const projectStatus: Record<Project['data']['status'], string> = {
  'in-progress': '进行中',
  completed: '已完成',
  archived: '已归档'
};
---

{items.length > 0 && (
  <section
    class:list={[
      'featured-carousel',
      `featured-carousel--${kind}`,
      { 'featured-carousel--interactive': items.length > 1 }
    ]}
    data-featured-carousel
    data-interval={interval}
    aria-label={carouselLabel}
    tabindex="0"
  >
    <div class="featured-carousel__slides">
      {isPost
        ? (items as Post[]).map((post, index) => (
            <article
              class:list={['featured-carousel__slide', { 'is-active': index === 0 }]}
              data-carousel-slide
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <a href={`/posts/${post.slug}/`} class="featured-card featured-card--post group">
                {post.data.cover && (
                  <div class="featured-card__cover featured-card__cover--post">
                    <img
                      src={post.data.cover}
                      alt=""
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                )}
                <div class="featured-card__body featured-card__body--post">
                  <div class="featured-card__eyebrow">
                    <span>{post.data.category === 'essay' ? '精选随笔' : '精选技术文章'}</span>
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="featured-card__link">阅读全文</span>
                </div>
              </a>
            </article>
          ))
        : (items as Project[]).map((project, index) => (
            <article
              class:list={['featured-carousel__slide', { 'is-active': index === 0 }]}
              data-carousel-slide
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <a href={`/projects/${project.slug}/`} class="featured-card featured-card--project group">
                <div class="featured-card__body featured-card__body--project">
                  <div class="featured-card__eyebrow">
                    <span>精选项目</span>
                    <span>{projectStatus[project.data.status]}</span>
                  </div>
                  {project.data.cover && (
                    <div class="featured-card__cover featured-card__cover--project">
                      <img
                        src={project.data.cover}
                        alt=""
                        loading={index === 0 ? 'eager' : 'lazy'}
                      />
                    </div>
                  )}
                  <h2>{project.data.title}</h2>
                  <p>{project.data.description}</p>
                  <div class="featured-card__stack" aria-label="技术栈">
                    {project.data.stack.slice(0, 3).map((item) => <span>{item}</span>)}
                  </div>
                  <span class="featured-card__project-link material-symbols-outlined" aria-hidden="true">
                    arrow_outward
                  </span>
                </div>
              </a>
            </article>
          ))}
    </div>

    {items.length > 1 && (
      <div class="featured-carousel__controls">
        <div class="featured-carousel__buttons">
          <button type="button" data-carousel-prev aria-label={`上一项${carouselLabel}`}>
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
          </button>
          <button type="button" data-carousel-autoplay aria-label={`暂停${carouselLabel}自动播放`}>
            <span class="material-symbols-outlined" aria-hidden="true">pause</span>
          </button>
          <button type="button" data-carousel-next aria-label={`下一项${carouselLabel}`}>
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </button>
        </div>
        <div class="featured-carousel__dots" aria-label={`${carouselLabel}分页`}>
          {items.map((_, index) => (
            <button
              type="button"
              data-carousel-dot={index}
              aria-label={`转到第 ${index + 1} 项`}
              aria-current={index === 0 ? 'true' : undefined}
            />
          ))}
        </div>
        <span class="featured-carousel__counter" data-carousel-counter aria-live="off">
          01 / {String(items.length).padStart(2, '0')}
        </span>
      </div>
    )}
  </section>
)}

<style>
  .featured-carousel {
    --carousel-shift: 1.25rem;

    position: relative;
    display: flex;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    flex-direction: column;
    outline: none;
  }

  .featured-carousel__slides {
    display: grid;
    min-height: 100%;
    flex: 1;
  }

  .featured-carousel__slide {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(var(--carousel-shift));
    transition:
      opacity 420ms ease,
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 480ms;
  }

  .featured-carousel[data-direction='prev'] .featured-carousel__slide {
    transform: translateX(calc(var(--carousel-shift) * -1));
  }

  .featured-carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .featured-card {
    display: flex;
    height: 100%;
    overflow: hidden;
    color: var(--on-surface);
    text-decoration: none;
    transition: background-color 300ms ease;
  }

  .featured-card--post {
    min-height: 19rem;
    flex-direction: column;
    background: var(--surface-container-low);
  }

  .featured-card--post:hover {
    background: var(--surface-container-high);
  }

  .featured-card--project {
    min-height: 19rem;
    background: var(--surface-container-highest);
  }

  .featured-card__cover {
    overflow: hidden;
  }

  .featured-card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    filter: grayscale(1);
    transition: transform 700ms ease, filter 300ms ease;
  }

  .featured-card:hover .featured-card__cover img {
    transform: scale(1.035);
    filter: grayscale(0.65);
  }

  .featured-card__cover--post {
    aspect-ratio: 16 / 7;
  }

  .featured-card__cover--post img {
    object-fit: cover;
  }

  .featured-card__cover--project {
    width: min(100%, 13rem);
    margin: 0 auto 2rem;
    aspect-ratio: 1;
    background: var(--surface-container-lowest);
  }

  .featured-card__cover--project img {
    padding: 1.5rem;
    object-fit: contain;
  }

  .featured-card__body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
  }

  .featured-card__body--post {
    padding: clamp(1.5rem, 2.5vw, 2rem);
  }

  .featured-card__body--project {
    width: 100%;
    padding: clamp(1.5rem, 2vw, 2rem);
  }

  .featured-carousel--interactive .featured-card__body {
    padding-bottom: 4.75rem;
  }

  .featured-card__eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    color: var(--on-surface-variant);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-card--post .featured-card__eyebrow span:first-child {
    color: var(--primary);
    font-weight: 700;
  }

  .featured-card--project .featured-card__eyebrow span:first-child {
    color: var(--secondary);
    font-weight: 700;
  }

  .featured-card h2 {
    margin: 0 0 1rem;
    font-family: var(--font-headline);
    font-weight: 600;
    line-height: 1.25;
  }

  .featured-card--post h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .featured-card--project h2 {
    font-size: 1.5rem;
  }

  .featured-card p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 1.25rem;
    color: var(--on-surface-variant);
    font-family: var(--font-body);
    line-height: 1.75;
    -webkit-box-orient: vertical;
  }

  .featured-card--post p {
    -webkit-line-clamp: 2;
  }

  .featured-card--project p {
    font-size: 0.875rem;
    -webkit-line-clamp: 2;
  }

  .featured-card__link {
    align-self: flex-start;
    margin-top: auto;
    border-bottom: 1px solid var(--primary);
    padding-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .featured-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-right: 3rem;
  }

  .featured-card__stack span {
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    background: var(--secondary-container);
    color: var(--on-secondary-container);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-card__project-link {
    align-self: flex-end;
    margin-top: -2rem;
    color: var(--primary);
    font-size: 2.25rem;
  }

  .featured-carousel__controls {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    background: transparent;
  }

  .featured-carousel__buttons,
  .featured-carousel__dots {
    display: flex;
    align-items: center;
  }

  .featured-carousel__buttons {
    gap: 0.25rem;
  }

  .featured-carousel__controls button {
    border: 0;
    color: var(--on-surface-variant);
    background: transparent;
    cursor: pointer;
  }

  .featured-carousel__buttons button {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
  }

  .featured-carousel__buttons .material-symbols-outlined {
    font-size: 1.125rem;
  }

  .featured-carousel__controls button:hover {
    color: var(--primary);
  }

  .featured-carousel__controls button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .featured-carousel__dots {
    justify-content: center;
    gap: 0.5rem;
  }

  .featured-carousel__dots button {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--outline-variant);
    transition: width 240ms ease, border-radius 240ms ease, background-color 240ms ease;
  }

  .featured-carousel__dots button[aria-current='true'] {
    width: 1.5rem;
    border-radius: 999px;
    background: var(--primary);
  }

  .featured-carousel__counter {
    color: var(--on-surface-variant);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 640px) {
    .featured-card--post,
    .featured-card--project {
      min-height: 18rem;
    }

    .featured-card__body--post,
    .featured-card__body--project {
      padding: 1.75rem;
    }

    .featured-carousel--interactive .featured-card__body {
      padding-bottom: 4.5rem;
    }

    .featured-carousel__controls {
      gap: 0.5rem;
      padding-inline: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-carousel__slide {
      transform: none;
      transition: opacity 180ms ease, visibility 0s linear 180ms;
    }

    .featured-carousel__slide.is-active {
      transition-delay: 0s;
    }

    .featured-card__cover img,
    .featured-carousel__dots button {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-featured-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    if (slides.length < 2) return;

    const previousButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const autoplayButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-autoplay]');
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const counter = carousel.querySelector<HTMLElement>('[data-carousel-counter]');
    const interval = Number(carousel.dataset.interval) || 7000;
    let currentIndex = 0;
    let timer: number | undefined;
    let pointerStartX: number | null = null;
    let pausedByUser = false;

    const canAutoplay = () =>
      !document.hidden && !pausedByUser;

    const stopAutoplay = () => {
      if (timer !== undefined) {
        window.clearTimeout(timer);
        timer = undefined;
      }
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!canAutoplay()) return;
      timer = window.setTimeout(() => showSlide(currentIndex + 1, false), interval);
    };

    const prepareManualAnnouncement = () => {
      if (!counter) return;
      counter.setAttribute('aria-live', 'polite');
      window.setTimeout(() => counter.setAttribute('aria-live', 'off'), 500);
    };

    const showSlide = (requestedIndex: number, manual: boolean) => {
      const nextIndex = (requestedIndex + slides.length) % slides.length;
      carousel.dataset.direction = requestedIndex < currentIndex ? 'prev' : 'next';
      currentIndex = nextIndex;

      slides.forEach((slide, index) => {
        const active = index === currentIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.inert = !active;
      });

      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      if (manual) prepareManualAnnouncement();
      if (counter) {
        counter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }
      startAutoplay();
    };

    const updateAutoplayButton = () => {
      if (!autoplayButton) return;
      autoplayButton.setAttribute(
        'aria-label',
        `${pausedByUser ? '继续' : '暂停'}${carousel.getAttribute('aria-label') ?? '精选内容'}自动播放`
      );
      const icon = autoplayButton.querySelector<HTMLElement>('.material-symbols-outlined');
      if (icon) icon.textContent = pausedByUser ? 'play_arrow' : 'pause';
    };

    slides.forEach((slide, index) => {
      slide.inert = index !== currentIndex;
    });

    previousButton?.addEventListener('click', () => showSlide(currentIndex - 1, true));
    nextButton?.addEventListener('click', () => showSlide(currentIndex + 1, true));
    autoplayButton?.addEventListener('click', () => {
      pausedByUser = !pausedByUser;
      updateAutoplayButton();
      if (pausedByUser) stopAutoplay();
      else startAutoplay();
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => showSlide(index, true)));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showSlide(currentIndex - 1, true);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showSlide(currentIndex + 1, true);
      }
    });

    carousel.addEventListener('touchstart', (event) => {
      pointerStartX = event.changedTouches[0]?.clientX ?? null;
      stopAutoplay();
    }, { passive: true });
    carousel.addEventListener('touchend', (event) => {
      if (pointerStartX === null) return;
      const distance = (event.changedTouches[0]?.clientX ?? pointerStartX) - pointerStartX;
      pointerStartX = null;
      if (Math.abs(distance) >= 48) {
        showSlide(currentIndex + (distance < 0 ? 1 : -1), true);
      } else {
        startAutoplay();
      }
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });
    reducedMotion.addEventListener('change', () => {
      updateAutoplayButton();
      startAutoplay();
    });
    updateAutoplayButton();
    startAutoplay();
  });
</script>
