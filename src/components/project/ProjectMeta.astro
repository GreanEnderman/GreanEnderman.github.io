---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// 状态标签映射
const statusLabels = {
  'in-progress': '进行中',
  'completed': '已完成',
  'archived': '已归档',
};
---

<div class="project-meta">
  <span class="project-meta-status">{statusLabels[project.data.status]}</span>
  <span class="project-meta-separator">·</span>
  <time class="project-meta-date" datetime={project.data.date.toISOString()}>
    {new Date(project.data.date).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long'
    })}
  </time>
</div>

<style>
  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--on-surface-variant);
  }

  .project-meta-status {
    font-weight: 600;
  }

  .project-meta-separator {
    opacity: 0.5;
  }

  .project-meta-date {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .project-meta {
      font-size: 0.8125rem;
    }
  }
</style>
