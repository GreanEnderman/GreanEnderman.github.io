---
import type { Post } from '@lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related-posts mt-16 pt-12 border-t border-[var(--outline-variant)] border-opacity-30">
    <h2 class="text-2xl font-headline font-bold text-[var(--on-surface)] mb-8">相关文章</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a href={`/posts/${post.slug}/`} class="related-post-card group">
          <div class="flex flex-wrap gap-2 mb-3">
            {post.data.tags.slice(0, 2).map((tag) => (
              <span class="text-xs font-label uppercase tracking-wider text-[var(--on-secondary-container)] bg-[var(--secondary-container)] px-2 py-1 rounded">
                {tag}
              </span>
            ))}
          </div>
          <h3 class="text-lg font-headline font-bold text-[var(--on-surface)] group-hover:text-[var(--primary)] transition-colors mb-2">
            {post.data.title}
          </h3>
          <p class="text-sm text-[var(--on-surface-variant)] line-clamp-2">
            {post.data.description}
          </p>
          <div class="flex items-center gap-2 mt-4 text-xs text-[var(--on-surface-variant)] font-label">
            <span>{new Date(post.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-post-card {
    display: block;
    padding: 1.5rem;
    background: var(--surface-container-low);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .related-post-card:hover {
    background: var(--surface-container-high);
    transform: translateY(-2px);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
